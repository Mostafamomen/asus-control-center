# ASUSCraft — ignored files
#
# The release artefacts (the RPMs, the DEB, the Flatpak bundle and
# SHA256SUMS.txt) are deliberately NOT committed: they are published as
# GitHub Release assets, where they can be downloaded and checksummed
# without bloating the source history.

# --- build outputs -------------------------------------------------------
/asus-control-center
/agent/asuscraft-agent
/launcher/launcher
*.o
*.a
*.so
*.lo

# --- packaging output -----------------------------------------------------
/dist/
/.rpmbuild/
/build/
/target/
*.rpm
*.deb
*.ddeb
*.changes
*.buildinfo
/asus-control-center-*.tar.gz
/debian/.debhelper/
/debian/asus-control-center/
/debian/debhelper-build-stamp
/debian/files
/debian/*.substvars
/debian/*.debhelper.log

# --- temporary Flatpak Builder state -------------------------------------
/.flatpak-builder/
/.flatpak-build/
/.flatpak-repo/
*.flatpakbuild
/.flatpak-builder-cache/

# --- temporary container scratch -----------------------------------------
/container/
/.debbuild/
/build-root/

# --- local logs and runtime state ----------------------------------------
*.log
/logs/
/run/
*.pid
*.sock

# --- local editor / IDE configuration -----------------------------------
.vscode/
.idea/
.cache/
*.swp
*.swo
*~

# --- local configuration and secrets -------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json
__pycache__/
*.py[cod]

# --- stale backup files --------------------------------------------------
*.backup
